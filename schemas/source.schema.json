{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "source_id",
    "title",
    "status",
    "access"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "access": {
      "enum": [
        "public",
        "internal",
        "restricted"
      ]
    },
    "url": {
      "type": "string"
    }
  }
}
